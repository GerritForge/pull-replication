      "writtenOn": "2026-11-02T12:24:23Z",
      "side": 1,
      "message": "What happens if a subsequent message then acks a newer offset than the failed requeue? Do we risk losing the requeue message?",
      "range": {
        "startLine": 16,
        "startChar": 61,
        "endLine": 17,
        "endChar": 35
      },
      "revId": "027582aff77c504057091c174619d997223e1c39",
